{
  "manifest_version": 3,
  "name": "NetSuite Helper (KoKo Black)",
  "version": "0.23.3",
  "description": "Quality-of-life tweaks for NetSuite, plus one-click Auto Print of the open label or invoice PDF.",
  "key": "",
  "permissions": ["activeTab", "downloads", "scripting", "nativeMessaging"],
  "host_permissions": ["https://*.netsuite.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Auto Print (labels -> label printer, invoices -> page printer)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://*.netsuite.com/app/common/search/searchresults.nl*"],
      "js": ["orders.js", "stats.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },    {
      "matches": ["https://*.netsuite.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.netsuite.com/app/accounting/wms/orderrelease/searchform/searchorders.nl*",
        "https://*.netsuite.com/app/accounting/transactions/wave.nl*"
      ],
      "js": ["lib/pdf-lib.min.js", "lib/packingslip-fix.js", "print.js", "waves.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.netsuite.com/app/accounting/print/printform.nl*"],
      "js": ["lib/pdf-lib.min.js", "lib/packingslip-fix.js", "print.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.netsuite.com/app/center/card.nl*"],
      "js": ["stats.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.netsuite.com/app/common/search/search.nl*"],
      "js": ["lib/pdf-lib.min.js", "lib/packingslip-fix.js", "ship.js", "bulkopen.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
